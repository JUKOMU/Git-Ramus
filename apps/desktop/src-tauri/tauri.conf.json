{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git-Ramus",
  "version": "0.1.0",
  "identifier": "io.git-ramus.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:plugins && npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git-Ramus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src git-ramus-plugin: http://git-ramus-plugin.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "resources": ["resources/plugins/**/*"]
  }
}
